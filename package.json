{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "storybook": "turbo storybook --filter=@repo/ui",
    "build-storybook": "turbo build-storybook --filter=@repo/ui"
  },
  "devDependencies": {
    "pnpm": "12.16.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.20.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}